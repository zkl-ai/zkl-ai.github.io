---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
import type { Lang } from '../data/resume';

interface Props {
  lang?: Lang;
  title?: string;
  description?: string;
  /** JSON-LD 结构化数据，会输出成 <script type="application/ld+json"> */
  structuredData?: Record<string, unknown>;
}

const {
  lang = 'zh',
  title,
  description = lang === 'zh'
    ? '张坤龙（Zhangkunlong）—— 多模态大模型推理加速 & AI Agent 工程师的个人简历与博客。'
    : 'Zhangkunlong — Engineer focused on multimodal LLM inference acceleration & AI Agent systems.',
  structuredData,
} = Astro.props;

const siteName = lang === 'zh' ? '张坤龙' : 'Zhangkunlong';
const fullTitle = title
  ? `${title} · ${siteName}`
  : lang === 'zh'
    ? '张坤龙 Zhangkunlong'
    : 'Zhangkunlong';

// 规范化地址：不管从 http / https / github.io 哪个入口进来，
// 都告诉搜索引擎只认这一个 URL。og 图也统一用绝对地址。
const site = Astro.site ?? new URL('https://zkl-ai.top/');
const canonicalURL = new URL(Astro.url.pathname, site).href;
const ogImageURL = new URL('/og.png', site).href;
---

<!doctype html>
<html lang={lang === 'zh' ? 'zh-CN' : 'en'}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title={lang === 'zh' ? '张坤龙的博客' : "Zhangkunlong's Blog"} href="/rss.xml" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={lang === 'zh' ? 'zh_CN' : 'en_US'} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />
    {structuredData && (
      <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    )}
  </head>
  <body>
    <Header lang={lang} />
    <main>
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>
