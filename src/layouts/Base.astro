---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
import type { Lang } from '../data/resume';

interface Props {
  lang?: Lang;
  title?: string;
  description?: string;
}

const {
  lang = 'zh',
  title,
  description = lang === 'zh'
    ? '张坤龙（Zhangkunlong）—— 多模态大模型推理加速 & AI Agent 工程师的个人简历与博客。'
    : 'Zhangkunlong — Engineer focused on multimodal LLM inference acceleration & AI Agent systems.',
} = Astro.props;

const siteName = lang === 'zh' ? '张坤龙' : 'Zhangkunlong';
const fullTitle = title
  ? `${title} · ${siteName}`
  : lang === 'zh'
    ? '张坤龙 Zhangkunlong'
    : 'Zhangkunlong';
---

<!doctype html>
<html lang={lang === 'zh' ? 'zh-CN' : 'en'}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title={lang === 'zh' ? '张坤龙的博客' : "Zhangkunlong's Blog"} href="/rss.xml" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
  </head>
  <body>
    <Header lang={lang} />
    <main>
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>
