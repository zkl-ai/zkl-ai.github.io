---
import Base from './Base.astro';
import { getCategory } from '../data/categories';

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  category?: string;
  tags?: string[];
}

const { title, description, pubDate, updatedDate, category, tags } = Astro.props;

function formatDate(d: Date) {
  return d.toISOString().slice(0, 10);
}
---

<Base title={title} description={description}>
  <article class="article">
    <a class="back-link" href="/blog">&larr; 返回博客</a>
    <header>
      <h1>{title}</h1>
      <div class="article-meta">
        <span>{formatDate(pubDate)}</span>
        {updatedDate && <span>更新于 {formatDate(updatedDate)}</span>}
        {category && <a href={`/blog/${category}/`}>{getCategory(category)?.name.zh}</a>}
        {tags?.map((t) => <a href={`/blog/tag/${t}/`}>#{t}</a>)}
      </div>
    </header>
    <div class="prose">
      <slot />
    </div>
  </article>
</Base>
