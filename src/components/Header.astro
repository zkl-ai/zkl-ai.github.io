---
import type { Lang } from '../data/resume';
import { resume } from '../data/resume';

interface Props {
  lang?: Lang;
}

const { lang = 'zh' } = Astro.props;
const d = resume[lang];
const prefix = lang === 'zh' ? '' : '/en';

const links = [
  { href: `${prefix}/#about`, label: d.nav.about },
  { href: `${prefix}/#experience`, label: d.nav.experience },
  { href: `${prefix}/#skills`, label: d.nav.skills },
  { href: `${prefix}/#publications`, label: d.nav.publications },
  { href: `${prefix}/#competitions`, label: d.nav.competitions },
  { href: '/blog', label: d.nav.blog },
];
---

<header class="site-header">
  <div class="container">
    <a class="brand" href={lang === 'zh' ? '/' : '/en/'}>
      {d.siteName}<span class="brand-sub"> / ZKL</span>
    </a>
    <nav class="site-nav">
      {
        links.map((l) => (
          <a href={l.href}>{l.label}</a>
        ))
      }
      <span class="lang-switch">
        <a href="/" class={lang === 'zh' ? 'active' : undefined}>中</a>
        <span class="lang-sep">/</span>
        <a href="/en/" class={lang === 'en' ? 'active' : undefined}>EN</a>
      </span>
    </nav>
  </div>
</header>
