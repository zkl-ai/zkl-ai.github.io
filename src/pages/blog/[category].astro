---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { categories } from '../../data/categories';

export async function getStaticPaths() {
  return categories.map((c) => ({
    params: { category: c.slug },
    props: { category: c },
  }));
}

const { category } = Astro.props;

const posts = (await getCollection('blog'))
  .filter((p) => !p.data.draft && p.data.category === category.slug)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

function formatDate(d: Date) {
  return d.toISOString().slice(0, 10);
}
---

<Base title={category.name.zh} description={category.description.zh}>
  <div class="container">
    <div class="page-head">
      <a class="back-link" href="/blog">&larr; 全部文章</a>
      <h1>{category.name.zh}</h1>
      <p>{category.description.zh}</p>
    </div>

    <div class="post-list">
      {
        posts.map((post) => (
          <a class="post-item" href={`/blog/${post.id}/`}>
            <div class="post-title">{post.data.title}</div>
            <div class="post-desc">{post.data.description}</div>
            <div class="post-meta">
              <span>{formatDate(post.data.pubDate)}</span>
              {post.data.tags?.map((t) => <span class="post-tag">#{t}</span>)}
            </div>
          </a>
        ))
      }
      {
        posts.length === 0 && <p style="color:var(--text-muted)">这个专区还没有文章，敬请期待。</p>
      }
    </div>
  </div>
</Base>
