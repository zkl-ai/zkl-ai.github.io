---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

const posts = (await getCollection('blog'))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

function formatDate(d: Date) {
  return d.toISOString().slice(0, 10);
}
---

<Base title="博客" description="张坤龙的博客 —— 大模型推理加速、AI Agent 与工程实践。">
  <div class="container">
    <div class="page-head">
      <h1>博客</h1>
      <p>记录大模型推理加速、AI Agent 与工程实践中的思考。</p>
    </div>

    <div class="post-list">
      {
        posts.map((post) => (
          <a class="post-item" href={`/blog/${post.id}/`}>
            <div class="post-title">{post.data.title}</div>
            <div class="post-desc">{post.data.description}</div>
            <div class="post-meta">
              <span>{formatDate(post.data.pubDate)}</span>
              {post.data.tags?.map((t) => <span class="post-tag">#{t}</span>)}
            </div>
          </a>
        ))
      }
      {
        posts.length === 0 && <p style="color:var(--text-muted)">还没有文章，敬请期待。</p>
      }
    </div>
  </div>
</Base>
