---
import Base from '../../layouts/Base.astro';
import { categories, getCategory } from '../../data/categories';
import { PAGE_SIZE, getPublishedPosts } from '../../lib/posts';

const allPosts = await getPublishedPosts();
const totalPages = Math.ceil(allPosts.length / PAGE_SIZE);
const posts = allPosts.slice(0, PAGE_SIZE);

function formatDate(d: Date) {
  return d.toISOString().slice(0, 10);
}
---

<Base title="博客" description="张坤龙的博客 —— 模型推理加速与长程智能体优化。">
  <div class="container">
    <div class="page-head">
      <h1>博客</h1>
      <p>记录模型推理加速与长程智能体优化方面的思考与实践。</p>
    </div>

    <!-- 专区 -->
    <div class="category-grid">
      {
        categories.map((c) => (
          <a class="category-card" href={`/blog/${c.slug}/`}>
            <h3>{c.name.zh}</h3>
            <p>{c.description.zh}</p>
          </a>
        ))
      }
    </div>

    <div class="post-list">
      {
        posts.map((post) => (
          <div class="post-item">
            <a class="post-title" href={`/blog/${post.id}/`}>{post.data.title}</a>
            <div class="post-desc">{post.data.description}</div>
            <div class="post-meta">
              {post.data.category && (
                <a class="post-category" href={`/blog/${post.data.category}/`}>
                  {getCategory(post.data.category)?.name.zh}
                </a>
              )}
              <span>{formatDate(post.data.pubDate)}</span>
              {post.data.tags?.map((t) => <a class="post-tag" href={`/blog/tag/${t}/`}>#{t}</a>)}
            </div>
          </div>
        ))
      }
      {
        posts.length === 0 && <p style="color:var(--text-muted)">还没有文章，敬请期待。</p>
      }
    </div>

    <!-- 分页 -->
    {
      totalPages > 1 && (
        <nav class="pagination">
          <span class="page-link disabled">&larr; 上一页</span>
          <span class="page-info">1 / {totalPages}</span>
          <a class="page-link" href="/blog/page/2/">下一页 &rarr;</a>
        </nav>
      )
    }
  </div>
</Base>
