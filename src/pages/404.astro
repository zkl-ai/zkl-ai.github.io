---
import Base from '../layouts/Base.astro';
---

<Base title="404 页面不存在" description="页面不存在">
  <div class="container" style="padding-top:120px;padding-bottom:120px;text-align:center">
    <h1 style="font-size:56px;font-weight:800;letter-spacing:-0.02em">404</h1>
    <p style="color:var(--text-muted);margin-top:12px">抱歉，你要找的页面不存在。</p>
    <p style="margin-top:24px">
      <a class="btn btn-primary" href="/">返回首页</a>
    </p>
  </div>
</Base>
